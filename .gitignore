build/
out/
*.obj
*.exe
*.lib
*.pdb
*.ilk

# --- no game data, ever -------------------------------------------------------
# The recompiler is the product; the game is yours. Nothing below is ever
# committed, and CI has no way to obtain any of it.
*.vpk
*.pkg
*.self
*.suprx
*.skprx
*.velf
eboot.bin
*.psvimg
sce_module/
sce_pfs/
sce_sys/

# Decrypted or extracted modules
*.elf
extracted/
modules/

# --- no key material, ever ----------------------------------------------------
# See docs/DECRYPT.md. Keys load from an external file; only the template with
# placeholder values is tracked.
keys/
!docs/vita_keys.example.txt

# Generated recompiler output — millions of lines, rebuilt from your own dump.
generated/

# --- vendored Vita3K ------------------------------------------------------------
# A verbatim upstream copy. The game-data patterns above (modules/, sce_sys/)
# match directories inside it that are source, not dumps, so it is re-included
# wholesale here.
!third_party/Vita3K/**/
!third_party/Vita3K/**

# Vita3K's submodule dependencies, fetched locally for a build; never committed.
# third_party/VITA3K.md pins their commits.
